---
import BaseLayout from "./BaseLayout.astro";
import MatchSituation from "../components/MatchSituation.astro";
import { getChapter, innings, totalChapters, type Stat } from "../data/innings";
import { url } from "../utils/paths";
import quizBank from "../data/quiz-bank.json";

interface Props {
  frontmatter: {
    title: string;
    /** cricket-flavoured tagline shown under the title */
    subtitle?: string;
    /** innings section slug, e.g. "first-innings" */
    innings: string;
    /** chapter slug, e.g. "regression" */
    chapter: string;
    meta: string;
    lede: string;
    commentary?: string;
    codeFile?: string;
    codeOut?: string;
    code?: string;
    stats?: Stat[];
  };
}

const { frontmatter: fm } = Astro.props;
const ctx = getChapter(fm.innings, fm.chapter);
if (!ctx) throw new Error(`Unknown chapter: ${fm.innings}/${fm.chapter}`);

const { innings: inn, chIdx, flatIdx, prev, next } = ctx;
const over = `${inn.index + 1}.${chIdx + 1}`;
const eyebrow = `${inn.short} · Over ${over}`;
const readTime = fm.meta.split(" · ")[0];
const codeLines = (fm.code ?? "").split("\n");

// Check if the current chapter has any questions in the quiz bank
const hasQuizQuestions = (quizBank as Array<{ chapterId: string }>).some(
  (q) => q.chapterId === fm.chapter,
);
---

<BaseLayout title={fm.title} description={fm.lede} section={inn.slug}>
  <!-- Scorebug readout (header slot) -->
  <Fragment slot="scorebug">
    <div class="flex flex-col gap-0.5 border-l border-white/10 px-4">
      <span class="font-mono text-[9px] uppercase tracking-[0.14em] text-mist"
        >Session</span
      >
      <span
        class="font-display text-lg font-extrabold leading-none tracking-[-0.02em] text-white"
        >{inn.index + 1} / {innings.length}</span
      >
    </div>
    <div class="flex flex-col gap-0.5 border-l border-white/10 px-4">
      <span class="font-mono text-[9px] uppercase tracking-[0.14em] text-mist"
        >Over</span
      >
      <span
        class="font-display text-lg font-extrabold leading-none tracking-[-0.02em] text-gold"
        >{over}</span
      >
    </div>
    <div class="flex flex-col gap-0.5 border-l border-white/10 px-4">
      <span class="font-mono text-[9px] uppercase tracking-[0.14em] text-mist"
        >Read rate</span
      >
      <span
        class="font-display text-lg font-extrabold leading-none tracking-[-0.02em] text-white"
        >{readTime}</span
      >
    </div>
    <div class="flex items-center gap-2.5 border-l border-white/10 pl-4">
      <div class="flex flex-col gap-[5px]">
        <span
          class="font-mono text-[9px] uppercase tracking-[0.14em] text-mist"
          >Course progress</span
        >
        <div
          class="h-1.5 w-[clamp(90px,14vw,150px)] overflow-hidden rounded-full bg-white/[0.12]"
        >
          <div
            id="header-progress-bar"
            class="h-full rounded-full bg-gradient-to-r from-gold to-gold-light transition-[width] duration-300"
            style="width:0%"
          >
          </div>
        </div>
      </div>
      <span
        id="header-progress-count"
        class="font-mono text-[11px] font-medium text-gold"
        >0/{totalChapters}</span
      >
    </div>
  </Fragment>

  <!-- ═══ BODY ═══ -->
  <div
    class="mx-auto flex w-full max-w-[1440px] flex-1 flex-wrap items-start gap-[clamp(16px,2vw,24px)] px-[clamp(14px,3vw,28px)] pb-14 pt-[clamp(16px,2.4vw,28px)]"
  >
    <!-- Sidebar — innings card (sticky only on desktop; scrolls away naturally on mobile) -->
    <aside
      class="flex min-w-[240px] max-w-full flex-[1_1_258px] flex-col gap-3.5 lg:sticky lg:top-[152px] lg:max-h-[calc(100vh-170px)] lg:max-w-[320px]"
    >
      <div
        class="min-h-0 flex-1 overflow-y-auto rounded-[14px] bg-pitch shadow-[0_2px_0_rgba(6,22,14,.06),0_10px_26px_rgba(6,22,14,.14)]"
      >

        <div
          class="flex flex-col gap-1 border-b border-white/[0.08] bg-[linear-gradient(90deg,rgba(226,183,20,.16),rgba(226,183,20,0))] px-4 py-3.5"
        >
          <span
            class="font-mono text-[9.5px] uppercase tracking-[0.16em] text-gold"
            >Innings card</span
          >
          <span
            class="font-display text-base font-bold tracking-[-0.02em] text-white"
            >{inn.title}</span
          >
        </div>
        <div class="flex flex-col p-1.5">
          {
            inn.chapters.map((c, j) => {
              const on = j === chIdx;
              return (
                <a
                  href={url(`${inn.slug}/${c.slug}/`)}
                  data-chapter-slug={c.slug}
                  class:list={[
                    "flex w-full items-center gap-[11px] rounded-[9px] p-2.5 transition-colors hover:bg-white/5",
                    on ? "bg-gold/[0.12] text-white" : "text-mist-light",
                  ]}
                >
                  <span
                    class:list={[
                      "flex h-[26px] w-[26px] flex-none items-center justify-center rounded-[7px] font-mono text-[11px] font-medium",
                      on ? "bg-gold text-pitch" : "bg-white/[0.08] text-mist",
                    ]}
                  >
                    {inn.index + 1}.{j + 1}
                  </span>
                  <span class="flex min-w-0 flex-col gap-0.5 text-left">
                    <span class="text-[13px] font-medium leading-[1.25]">
                      {c.nav}
                    </span>
                    <span class="font-mono text-[9.5px] tracking-[0.06em] text-mist">
                      {c.meta}
                    </span>
                  </span>
                  <span
                    data-chapter-tick
                    class="ml-auto hidden flex-none font-mono text-[12px] text-gold"
                    aria-hidden="true"
                  >
                    ✓
                  </span>
                </a>
              );
            })
          }
        </div>
      </div>

      <MatchSituation />

      <!-- Pinned LHN footer — external links -->
      <div
        class="flex flex-none flex-col gap-1 rounded-[14px] border-t-2 border-gold bg-pitch-dark p-1.5 shadow-[0_2px_0_rgba(6,22,14,.06),0_10px_26px_rgba(6,22,14,.14)]"
      >
        <a
          href="https://www.linkedin.com/in/john-fong-04b7a120/"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center gap-[11px] rounded-[9px] p-2.5 text-mist-light transition-colors hover:bg-white/5 hover:text-white"
        >
          <span
            class="flex h-[26px] w-[26px] flex-none items-center justify-center rounded-[7px] bg-white/[0.08] text-gold"
          >
            <svg
              viewBox="0 0 24 24"
              fill="currentColor"
              class="h-[14px] w-[14px]"
              aria-hidden="true"
            >
              <path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
              />
            </svg>
          </span>
          <span class="flex min-w-0 flex-col gap-0.5 text-left">
            <span class="text-[13px] font-medium leading-[1.25]"
              >Contact John Fong</span
            >
            <span class="font-mono text-[9.5px] tracking-[0.06em] text-mist">
              linkedin · /in/john-fong
            </span>
          </span>
          <span
            class="ml-auto font-mono text-[11px] text-mist transition-colors group-hover:text-gold"
            >↗</span
          >
        </a>
        <a
          href="https://github.com/jf8peas/explain-machine-learning-in-cricket-terms/issues/new"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center gap-[11px] rounded-[9px] p-2.5 text-mist-light transition-colors hover:bg-white/5 hover:text-white"
        >
          <span
            class="flex h-[26px] w-[26px] flex-none items-center justify-center rounded-[7px] bg-white/[0.08] font-mono text-[10px] font-semibold tracking-[0.02em] text-gold"
            >GH</span
          >
          <span class="flex min-w-0 flex-col gap-0.5 text-left">
            <span class="text-[13px] font-medium leading-[1.25]"
              >Feedback / Report Issue</span
            >
            <span class="font-mono text-[9.5px] tracking-[0.06em] text-mist">
              github issues · new
            </span>
          </span>
          <span
            class="ml-auto font-mono text-[11px] text-mist transition-colors group-hover:text-gold"
            >↗</span
          >
        </a>
      </div>
    </aside>


    <!-- Main content container -->
    <main
      class="min-w-0 flex-[3_1_520px] overflow-hidden rounded-2xl border border-line bg-white shadow-[0_1px_0_rgba(11,15,13,.04),0_12px_30px_rgba(11,15,13,.06)]"
    >
      <!-- Chapter hero -->
      <div
        class="relative overflow-hidden bg-[linear-gradient(140deg,#0B2B1A_0%,#0F3A24_55%,#071D11_100%)] px-[clamp(20px,3.4vw,44px)] pb-[clamp(18px,2.6vw,26px)] pt-[clamp(22px,3.4vw,38px)]"
      >
        <div
          class="pointer-events-none absolute inset-0"
          style="background:repeating-linear-gradient(115deg,rgba(255,255,255,.045) 0 1px,transparent 1px 22px)"
        >
        </div>
        <div class="relative flex flex-col gap-3.5">
          <div class="flex flex-wrap items-center gap-2">
            <span
              class="inline-flex h-[23px] items-center rounded-full bg-gold px-2.5 font-mono text-[9.5px] font-medium uppercase tracking-[0.14em] text-pitch"
              >{eyebrow}</span
            >
            <span
              class="inline-flex h-[23px] items-center whitespace-nowrap rounded-full border border-white/[0.18] px-2.5 font-mono text-[9.5px] uppercase tracking-[0.12em] text-mist-lighter"
              >{fm.meta}</span
            >
            <span
              class="inline-flex h-[23px] items-center whitespace-nowrap rounded-full border border-white/[0.18] px-2.5 font-mono text-[9.5px] uppercase tracking-[0.12em] text-mist-lighter"
              >Python 3.11</span
            >
          </div>
          <h1
            class="m-0 text-balance font-display text-[clamp(30px,4.4vw,52px)] font-extrabold leading-[1.02] tracking-[-0.035em] text-white"
          >
            {fm.title}
          </h1>
          {
            fm.subtitle && (
              <p class="m-0 font-display text-[clamp(15px,1.6vw,19px)] font-semibold italic leading-[1.3] text-gold">
                {fm.subtitle}
              </p>
            )
          }
          <p
            class="m-0 max-w-[62ch] text-pretty text-[clamp(15px,1.35vw,17.5px)] leading-[1.55] text-mist-light"
          >
            {fm.lede}
          </p>
        </div>
      </div>

      <!-- Body -->
      <article
        class="flex flex-col gap-[clamp(20px,2.4vw,30px)] px-[clamp(20px,3.4vw,44px)] py-[clamp(22px,3vw,38px)]"
      >
        <div
          class="prose prose-neutral max-w-[72ch] prose-headings:font-display prose-h2:text-[clamp(20px,2.1vw,27px)] prose-h2:font-bold prose-h2:leading-[1.15] prose-h2:tracking-[-0.028em] prose-h2:text-pitch prose-h3:text-pitch prose-p:text-[15.5px] prose-p:leading-[1.68] prose-p:text-ink-soft prose-a:font-medium prose-a:text-pitch hover:prose-a:text-gold-deep prose-strong:text-ink prose-code:font-mono prose-li:text-[15.5px] prose-li:leading-[1.68] prose-li:text-ink-soft"
        >
          <slot />
        </div>

        <!-- Commentary box callout -->
        {
          fm.commentary && (
            <aside class="flex gap-3.5 rounded-xl border border-line border-l-[3px] border-l-gold bg-card px-[18px] py-4">
              <div class="flex h-[34px] w-[34px] flex-none items-center justify-center rounded-full bg-pitch font-mono text-[10px] tracking-[0.04em] text-gold">
                CB
              </div>
              <div class="flex min-w-0 flex-col gap-[5px]">
                <span class="font-mono text-[9.5px] uppercase tracking-[0.16em] text-slate-custom">
                  From the commentary box
                </span>
                <p class="m-0 text-pretty text-[14.5px] leading-[1.6] text-ink">
                  {fm.commentary}
                </p>
              </div>
            </aside>
          )
        }

        <!-- Code block -->
        {
          fm.code && (
            <div class="flex flex-col gap-2.5">
              <div class="flex items-baseline gap-3">
                <span class="pt-1 font-mono text-[10.5px] font-medium tracking-[0.14em] text-gold">
                  03
                </span>
                <h2 class="m-0 text-balance font-display text-[clamp(20px,2.1vw,27px)] font-bold leading-[1.15] tracking-[-0.028em] text-pitch">
                  Into the nets
                </h2>
              </div>
              <div class="overflow-hidden rounded-xl border border-pitch-mid bg-pitch-dark shadow-[0_10px_24px_rgba(6,22,14,.16)]">
                <div class="flex items-center gap-2.5 border-b border-white/[0.08] bg-pitch py-[9px] pl-3.5 pr-3">
                  <span class="h-2 w-2 flex-none rounded-full bg-gold" />
                  <span class="overflow-hidden text-ellipsis whitespace-nowrap font-mono text-[11px] tracking-[0.02em] text-mist-lighter">
                    {fm.codeFile}
                  </span>
                  <span class="flex-1" />
                  <span class="font-mono text-[9.5px] uppercase tracking-[0.12em] text-mist">
                    py
                  </span>
                </div>
                <div class="overflow-x-auto pb-4 pt-3.5">
                  {codeLines.map((line, i) => (
                    <div class="flex gap-3.5 px-4 font-mono text-[13px] leading-[1.75]">
                      <span class="w-4 flex-none select-none text-right text-stump">
                        {i + 1}
                      </span>
                      <span class="min-w-0 whitespace-pre text-mist-lighter">
                        {line.trimEnd().length ? line : " "}
                      </span>
                    </div>
                  ))}
                </div>
                {fm.codeOut && (
                  <div class="flex flex-wrap gap-2 border-t border-white/[0.06] bg-pitch-line px-3.5 py-2.5">
                    <span class="font-mono text-[10px] uppercase tracking-[0.1em] text-mist">
                      Output
                    </span>
                    <span class="font-mono text-[11.5px] text-run">
                      {fm.codeOut}
                    </span>
                  </div>
                )}
              </div>
            </div>
          )
        }

        <!-- Practice nets callout (only shown if this chapter has questions in the bank) -->
        {hasQuizQuestions && (
          <div
            class="flex flex-wrap items-center gap-5 rounded-[14px] border border-pitch bg-pitch px-6 py-[22px]"
          >
            <div class="flex min-w-0 flex-[1_1_260px] flex-col gap-[7px]">
              <span
                class="font-mono text-[10.5px] uppercase tracking-[0.18em] text-gold"
                >Exercise · Over {over}</span
              >
              <span
                class="font-display text-[clamp(20px,1.9vw,26px)] font-bold leading-[1.15] tracking-[-0.03em] text-white"
                >Enter the practice nets</span
              >
              <span class="font-mono text-[12px] text-mist"
                >15 questions · 10 multiple choice · 5 short answer</span
              >
            </div>
            <a
              href={url(`practice-nets/?chapter=${fm.chapter}`)}
              class="inline-flex h-12 flex-none items-center gap-2.5 rounded-[10px] bg-gold px-6 font-sans text-[16px] font-semibold whitespace-nowrap text-pitch transition-colors hover:bg-gold-light"
            >
              Enter the practice nets
              <span class="font-mono text-[15px]">→</span>
            </a>
          </div>
        )}
        {
          fm.stats && fm.stats.length > 0 && (
            <div class="grid grid-cols-[repeat(auto-fit,minmax(118px,1fr))] gap-px overflow-hidden rounded-xl border border-line bg-white">
              {fm.stats.map((st) => (
                <div class="flex flex-col gap-[5px] bg-white px-4 py-3.5 shadow-[0_0_0_1px_#E5E7EB]">
                  <span class="font-mono text-[9.5px] uppercase tracking-[0.14em] text-slate-custom">
                    {st.k}
                  </span>
                  <span class="font-display text-[22px] font-bold leading-none tracking-[-0.03em] text-pitch">
                    {st.v}
                  </span>
                  <span class="text-[11.5px] text-gray-500">{st.s}</span>
                </div>
              ))}
            </div>
          )
        }

        <!-- Over nav footer (prev/next are undefined at the course boundaries) -->
        <div class="mt-0.5 flex flex-wrap gap-3 border-t border-line pt-2">
          {
            ctx?.prev ? (
              <a
                href={url(`${ctx.prev?.innings.slug}/${ctx.prev?.chapter.slug}/`)}
                class="flex flex-[1_1_220px] items-center gap-3 rounded-xl border border-line bg-white px-4 py-3.5 text-left transition-colors hover:border-pitch hover:bg-card"
              >
                <span class="font-mono text-[15px] text-gold">←</span>
                <span class="flex min-w-0 flex-col gap-[3px]">
                  <span class="font-mono text-[9.5px] uppercase tracking-[0.14em] text-slate-custom">
                    Previous over
                  </span>
                  <span class="overflow-hidden text-ellipsis whitespace-nowrap text-sm font-medium text-pitch">
                    {ctx.prev?.chapter.nav}
                  </span>
                </span>
              </a>
            ) : (
              <div />
            )
          }
          {
            ctx?.next ? (
              <a
                href={url(`${ctx.next?.innings.slug}/${ctx.next?.chapter.slug}/`)}
                class="flex flex-[1_1_220px] items-center justify-end gap-3 rounded-xl border border-pitch bg-pitch px-4 py-3.5 text-right transition-colors hover:bg-pitch-mid"
              >
                <span class="flex min-w-0 flex-col items-end gap-[3px]">
                  <span class="font-mono text-[9.5px] uppercase tracking-[0.14em] text-gold">
                    Next over
                  </span>
                  <span class="overflow-hidden text-ellipsis whitespace-nowrap text-sm font-medium text-white">
                    {ctx.next?.chapter.nav}
                  </span>
                </span>
                <span class="font-mono text-[15px] text-gold">→</span>
              </a>
            ) : (
              <div />
            )
          }
        </div>

        <!-- Scroll-to-complete trigger — watched by the IntersectionObserver in the script below -->
        <div
          id="chapter-completion-trigger"
          data-chapter-id={fm.chapter}
          data-total-chapters={totalChapters}
          class="h-px w-full"
          aria-hidden="true"
        >
        </div>
      </article>
    </main>
  </div>
</BaseLayout>

<script>
  import {
    PROGRESS_EVENT,
    initChapterCompletionTrigger,
    loadProgress,
  } from "../utils/progress";

  const triggerEl = document.getElementById("chapter-completion-trigger");
  const totalChapters = Number(triggerEl?.dataset.totalChapters ?? 0);

  const headerBar = document.getElementById("header-progress-bar");
  const headerCount = document.getElementById("header-progress-count");
  const chapterLinks = document.querySelectorAll("[data-chapter-slug]");

  /** Re-render the Header progress + LHN innings card ticks from storage. */
  function refreshProgressUI(): void {
    const data = loadProgress();
    const done = data.completedChapters.length;
    const pct =
      totalChapters > 0 ? Math.min(100, Math.round((done / totalChapters) * 100)) : 0;

    // Header scorebug — course progress bar + count
    if (headerBar) headerBar.style.width = `${pct}%`;
    if (headerCount) headerCount.textContent = `${done}/${totalChapters}`;

    // LHN innings card — tick the chapters already read
    chapterLinks.forEach((link) => {
      const slug = link.getAttribute("data-chapter-slug");
      const tick = link.querySelector("[data-chapter-tick]");
      if (slug && tick) {
        tick.classList.toggle("hidden", !data.completedChapters.includes(slug));
      }
    });
  }

  // Initial paint from storage, then live updates on every progress change.
  refreshProgressUI();
  window.addEventListener(PROGRESS_EVENT, refreshProgressUI);
  initChapterCompletionTrigger();
</script>
