---
import "../styles/global.css";
import { innings } from "../data/innings";
import { url } from "../utils/paths";
import SearchBar from "../components/SearchBar.astro";

interface Props {
  title: string;
  description?: string;
  /** slug of the active innings section, for nav highlighting */
  section?: string;
}

const {
  title,
  description = "Machine learning explained in cricket terms.",
  section,
} = Astro.props;

/** Short labels for the 860–1559px tier (single row, no wrapping). */
const navShort: Record<string, string> = {
  about: "About",
  "pre-game-preparation": "Pre-Game",
  "scoring-model-evaluation": "Scoring",
  "first-innings": "First Innings",
  "second-innings": "Second Innings",
  "post-game": "Post-Game",
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-T3N5834YES"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-T3N5834YES');
    </script>
    <link rel="icon" type="image/svg+xml" href={url("favicon.svg")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Geist:wght@400..800&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title} · The Playing XI</title>
  </head>
  <body>
    <div class="flex min-h-screen flex-col bg-canvas">
      <!-- ═══ SCOREBUG HEADER (sticky on desktop; scrolls away on mobile so reading content stays unblocked) ═══ -->
      <header
        class="z-20 border-b-2 border-gold bg-gradient-to-b from-pitch to-pitch-deep shadow-[0_8px_24px_rgba(6,22,14,.28)] lg:sticky lg:top-0"
      >

        <div
          class="mx-auto flex min-h-[74px] max-w-[1440px] flex-wrap items-stretch px-[clamp(14px,3vw,28px)]"
        >
          <!-- Brand blade -->
          <a
            href={url()}
            class="flex min-w-0 flex-[1_1_260px] items-center gap-3.5 py-3 pr-[22px]"
          >
            <div
              class="flex h-11 w-11 flex-none items-center justify-center rounded-[10px] bg-gold font-display text-[19px] font-extrabold tracking-[-0.04em] text-pitch shadow-[0_2px_0_rgba(0,0,0,.25)]"
            >
              XI
            </div>
            <div class="flex min-w-0 flex-col gap-[3px]">
              <span
                class="font-mono text-[9.5px] font-medium uppercase tracking-[0.18em] text-gold"
                >Broadcast Centre</span
              >
              <span
                class="overflow-hidden text-ellipsis whitespace-nowrap font-display text-[clamp(17px,2.2vw,22px)] font-extrabold leading-none tracking-[-0.025em] text-white"
              >
                The Playing XI<span class="font-semibold text-mist">
                  · ML in Cricket Terms</span
                >
              </span>
            </div>
          </a>

          <!-- Search -->
          <SearchBar />

          <!-- Scorebug readout -->
          <div class="flex flex-wrap items-center py-2.5">
            <div class="flex items-center gap-2 border-l border-white/10 px-4">
              <span class="h-[7px] w-[7px] animate-blink rounded-full bg-gold"
              ></span>
              <span
                class="font-mono text-[10px] font-medium uppercase tracking-[0.14em] text-mist-lighter"
                >Live</span
              >
            </div>
            <slot name="scorebug" />
          </div>
        </div>

        <!-- ═══ SESSION NAVIGATION (single-row, three responsive tiers) ═══ -->
        <nav class="border-b-2 border-gold border-t border-white/[0.07] bg-pitch-dark">
          <div class="mx-auto max-w-[1440px] px-[clamp(14px,3vw,28px)]">
            <!-- Tier 1 & 2: horizontal row (full titles ≥1560px, short labels 860–1559px) -->
            <div
              id="session-nav-row"
              class="flex items-stretch overflow-x-auto"
            >
              {
                innings.map((inn) => {
                  const active = section === inn.slug;
                  return (
                    <a
                      href={url(`${inn.slug}/`)}
                      class:list={[
                        "flex flex-none items-center gap-[11px] border-b-4 px-[18px] py-[13px] text-left transition-colors hover:bg-gold/[0.08]",
                        active
                          ? "border-gold bg-gold/10 text-white"
                          : "border-transparent text-[#c3d2c8]",
                      ]}
                    >
                      <span class="flex-none font-mono text-[12px] font-medium tracking-[0.06em] text-gold">
                        {inn.number}
                      </span>
                      <span class="font-display text-[14.5px] font-semibold leading-[1.24] tracking-[-0.015em] whitespace-nowrap">
                        <span class="nav-label-full">{inn.title}</span>
                        <span class="nav-label-short hidden">{navShort[inn.slug] ?? inn.short}</span>
                      </span>
                    </a>
                  );
                })
              }
              <!-- Practice Nets link (session 07) -->
              <a
                href={url("practice-nets/")}
                class:list={[
                  "flex flex-none items-center gap-[11px] border-b-4 px-[18px] py-[13px] text-left transition-colors hover:bg-gold/[0.08]",
                  section === "practice-nets"
                    ? "border-gold bg-gold/10 text-white"
                    : "border-transparent text-[#c3d2c8]",
                ]}
              >
                <span class="flex-none font-mono text-[12px] font-medium tracking-[0.06em] text-gold">
                  07
                </span>
                <span class="font-display text-[14.5px] font-semibold leading-[1.24] tracking-[-0.015em] whitespace-nowrap">
                  <span class="nav-label-full">Practice Nets</span>
                  <span class="nav-label-short hidden">Nets</span>
                </span>
              </a>
            </div>

            <!-- Tier 3: mobile dropdown (<860px) -->
            <div
              id="session-nav-compact"
              class="hidden items-center gap-2.5 py-2.5"
            >
              <span
                class="flex-none font-mono text-[11px] uppercase tracking-[0.16em] text-mist"
                >Session</span
              >
              <select
                id="session-nav-select"
                class="h-11 min-w-0 flex-1 cursor-pointer appearance-none rounded-[10px] border border-white/[0.16] bg-pitch px-3.5 font-display text-[15px] font-semibold text-white outline-none"
              >
                {
                  innings.map((inn) => (
                    <option
                      value={url(`${inn.slug}/`)}
                      selected={section === inn.slug}
                    >
                      {inn.number} {inn.title}
                    </option>
                  ))
                }
                <option
                  value={url("practice-nets/")}
                  selected={section === "practice-nets"}
                >
                  07 Practice Nets
                </option>
              </select>
            </div>
          </div>
        </nav>

      </header>

      <slot />

      <!-- ═══ FOOTER ═══ -->
      <footer
        class="mt-auto border-t border-white/[0.07] bg-pitch-dark px-[clamp(14px,3vw,28px)] py-[18px]"
      >
        <div
          class="mx-auto flex max-w-[1440px] flex-wrap items-center justify-between gap-3"
        >
          <div class="flex flex-wrap items-center gap-3">
            <span
              class="font-mono text-[10px] uppercase tracking-[0.14em] text-mist"
              >The Playing XI</span
            >
            <span class="font-mono text-[10px] text-mist">·</span>
            <div class="flex flex-wrap items-center gap-2.5">
              <a
                href="https://www.linkedin.com/in/john-fong-04b7a120/"

              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 rounded-full border border-white/[0.12] px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.14em] text-mist-light transition-colors hover:border-gold hover:text-white"
            >
              <svg
                viewBox="0 0 24 24"
                fill="currentColor"
                class="h-[12px] w-[12px] text-gold"
                aria-hidden="true"
              >
                <path
                  d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                />
              </svg>
               Contact Me
            </a>
            <span class="font-mono text-[10px] text-mist">·</span>
            <a
              href="https://github.com/jf8peas/explain-machine-learning-in-cricket-terms/issues/new"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 rounded-full border border-white/[0.12] px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.14em] text-mist-light transition-colors hover:border-gold hover:text-white"
            >
              <span class="font-mono text-[9px] font-semibold tracking-[0.02em] text-gold">GH</span>
              Feedback
            </a>
            </div>
          </div>
          <span
            class="font-mono text-[10px] uppercase tracking-[0.14em] text-stump"
            >Stumps drawn at 18:30</span
          >
        </div>
      </footer>
    </div>

    <!-- Session nav responsive tiers (≥1560px full titles · 860–1559px short labels · <860px dropdown) -->
    <script is:inline>
      (function () {
        if (typeof window === "undefined") return;
        var row = document.getElementById("session-nav-row");
        var compact = document.getElementById("session-nav-compact");
        if (!row || !compact) return;

        var FULL_MIN = 1560;
        var SHORT_MIN = 860;

        function applyTier() {
          var w = window.innerWidth;
          var full = w >= FULL_MIN;
          var short = w >= SHORT_MIN && w < FULL_MIN;
          var mobile = w < SHORT_MIN;

          // Toggle the two horizontal-row label spans
          var fullLabels = row.querySelectorAll(".nav-label-full");
          var shortLabels = row.querySelectorAll(".nav-label-short");
          for (var i = 0; i < fullLabels.length; i++) {
            fullLabels[i].classList.toggle("hidden", !full);
          }
          for (var j = 0; j < shortLabels.length; j++) {
            shortLabels[j].classList.toggle("hidden", !short);
          }

          // Toggle row vs compact dropdown
          row.classList.toggle("hidden", mobile);
          compact.classList.toggle("hidden", !mobile);
          compact.classList.toggle("flex", mobile);
        }

        var raf = 0;
        function onResize() {
          if (raf) return;
          raf = requestAnimationFrame(function () {
            raf = 0;
            applyTier();
          });
        }

        applyTier();
        window.addEventListener("resize", onResize);
      })();
    </script>

    <!-- Reading progress & daily streak tracking (localStorage) — runs on every page -->
    <script>
      import { initProgressTracking } from "../utils/progress";
      initProgressTracking();
    </script>
  </body>
</html>