---
import "../styles/global.css";
import { innings } from "../data/innings";
import { url } from "../utils/paths";

interface Props {
  title: string;
  description?: string;
  /** slug of the active innings section, for nav highlighting */
  section?: string;
}

const {
  title,
  description = "Machine learning explained in cricket terms.",
  section,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-T3N5834YES"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-T3N5834YES');
    </script>
    <link rel="icon" type="image/svg+xml" href={url("favicon.svg")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Geist:wght@400..800&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title} · The Playing XI</title>
  </head>
  <body>
    <div class="flex min-h-screen flex-col bg-canvas">
      <!-- ═══ SCOREBUG HEADER (sticky on desktop; scrolls away on mobile so reading content stays unblocked) ═══ -->
      <header
        class="z-20 border-b-2 border-gold bg-gradient-to-b from-pitch to-pitch-deep shadow-[0_8px_24px_rgba(6,22,14,.28)] lg:sticky lg:top-0"
      >

        <div
          class="mx-auto flex min-h-[74px] max-w-[1440px] flex-wrap items-stretch px-[clamp(14px,3vw,28px)]"
        >
          <!-- Brand blade -->
          <a
            href={url()}
            class="flex min-w-0 flex-[1_1_260px] items-center gap-3.5 py-3 pr-[22px]"
          >
            <div
              class="flex h-11 w-11 flex-none items-center justify-center rounded-[10px] bg-gold font-display text-[19px] font-extrabold tracking-[-0.04em] text-pitch shadow-[0_2px_0_rgba(0,0,0,.25)]"
            >
              XI
            </div>
            <div class="flex min-w-0 flex-col gap-[3px]">
              <span
                class="font-mono text-[9.5px] font-medium uppercase tracking-[0.18em] text-gold"
                >Broadcast Centre</span
              >
              <span
                class="overflow-hidden text-ellipsis whitespace-nowrap font-display text-[clamp(17px,2.2vw,22px)] font-extrabold leading-none tracking-[-0.025em] text-white"
              >
                The Playing XI<span class="font-semibold text-mist">
                  · ML in Cricket Terms</span
                >
              </span>
            </div>
          </a>

          <!-- Scorebug readout -->
          <div class="flex flex-wrap items-center py-2.5">
            <div class="flex items-center gap-2 border-l border-white/10 px-4">
              <span class="h-[7px] w-[7px] animate-blink rounded-full bg-gold"
              ></span>
              <span
                class="font-mono text-[10px] font-medium uppercase tracking-[0.14em] text-mist-lighter"
                >Live</span
              >
            </div>
            <slot name="scorebug" />
          </div>
        </div>

        <!-- ═══ INNINGS NAVIGATION (wraps to rows — no horizontal scroll) ═══ -->
        <nav class="border-t border-white/[0.07] bg-pitch-dark">
          <div
            class="mx-auto flex max-w-[1440px] flex-wrap px-[clamp(14px,3vw,28px)]"
          >
            {
              innings.map((inn) => {
                const active = section === inn.slug;
                return (
                  <a
                    href={url(`${inn.slug}/`)}
                    class:list={[
                      "flex min-w-0 flex-1 basis-[140px] items-center gap-[10px] border-b-[3px] px-[14px] py-2.5 text-left transition-colors hover:bg-gold/[0.07]",
                      active
                        ? "border-gold bg-gold/10 text-white"
                        : "border-transparent text-[#b9c9be]",
                    ]}
                  >
                    <span class="flex-none font-mono text-[10px] font-medium tracking-[0.1em] text-gold">
                      {inn.number}
                    </span>
                    <span class="line-clamp-2 font-display text-sm font-semibold leading-[1.2] tracking-[-0.01em]">
                      {inn.title}
                    </span>
                  </a>
                );
              })
            }
          </div>
        </nav>

      </header>

      <slot />

      <!-- ═══ FOOTER ═══ -->
      <footer
        class="mt-auto border-t border-white/[0.07] bg-pitch-dark px-[clamp(14px,3vw,28px)] py-[18px]"
      >
        <div
          class="mx-auto flex max-w-[1440px] flex-wrap items-center justify-between gap-3"
        >
          <div class="flex flex-wrap items-center gap-3">
            <span
              class="font-mono text-[10px] uppercase tracking-[0.14em] text-mist"
              >The Playing XI</span
            >
            <div class="flex flex-wrap items-center gap-2.5">
              <a
                href="https://www.linkedin.com/in/john-fong-04b7a120/"

              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 rounded-full border border-white/[0.12] px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.14em] text-mist-light transition-colors hover:border-gold hover:text-white"
            >
              <svg
                viewBox="0 0 24 24"
                fill="currentColor"
                class="h-[12px] w-[12px] text-gold"
                aria-hidden="true"
              >
                <path
                  d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                />
              </svg>
              Contact Me
            </a>
            <a
              href="https://github.com/jf8peas/explain-machine-learning-in-cricket-terms/issues/new"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 rounded-full border border-white/[0.12] px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.14em] text-mist-light transition-colors hover:border-gold hover:text-white"
            >
              <span class="font-mono text-[9px] font-semibold tracking-[0.02em] text-gold">GH</span>
              Feedback
            </a>
            </div>
          </div>
          <span
            class="font-mono text-[10px] uppercase tracking-[0.14em] text-stump"
            >Stumps drawn at 18:30</span
          >
        </div>
      </footer>
    </div>
  </body>
</html>
