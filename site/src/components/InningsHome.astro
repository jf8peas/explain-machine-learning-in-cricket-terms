---
import MatchSituation from "./MatchSituation.astro";
import { getInnings } from "../data/innings";
import { url } from "../utils/paths";

interface Props {
  /** innings section slug */
  slug: string;
}

const inn = getInnings(Astro.props.slug);
if (!inn) throw new Error(`Unknown innings section: ${Astro.props.slug}`);
---

<div
  class="mx-auto flex w-full max-w-[1440px] flex-1 flex-wrap items-start gap-[clamp(16px,2vw,24px)] px-[clamp(14px,3vw,28px)] pb-14 pt-[clamp(16px,2.4vw,28px)]"
>
  <!-- LHN -->
  <aside
    class="flex min-w-[240px] max-w-full flex-[1_1_258px] flex-col gap-3.5 lg:sticky lg:top-[152px] lg:max-h-[calc(100vh-170px)] lg:max-w-[320px]"
  >
    <MatchSituation />

    <!-- Pinned LHN footer — external links -->
    <div
      class="flex flex-none flex-col gap-1 rounded-[14px] border-t-2 border-gold bg-pitch-dark p-1.5 shadow-[0_2px_0_rgba(6,22,14,.06),0_10px_26px_rgba(6,22,14,.14)]"
    >
      <a
        href="https://www.linkedin.com/in/john-fong-04b7a120/"
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center gap-[11px] rounded-[9px] p-2.5 text-mist-light transition-colors hover:bg-white/5 hover:text-white"
      >
        <span
          class="flex h-[26px] w-[26px] flex-none items-center justify-center rounded-[7px] bg-white/[0.08] text-gold"
        >
          <svg
            viewBox="0 0 24 24"
            fill="currentColor"
            class="h-[14px] w-[14px]"
            aria-hidden="true"
          >
            <path
              d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
            />
          </svg>
        </span>
        <span class="flex min-w-0 flex-col gap-0.5 text-left">
          <span class="text-[13px] font-medium leading-[1.25]"
            >Contact John Fong</span
          >
          <span class="font-mono text-[9.5px] tracking-[0.06em] text-mist">
            linkedin · /in/john-fong
          </span>
        </span>
        <span
          class="ml-auto font-mono text-[11px] text-mist transition-colors group-hover:text-gold"
          >↗</span
        >
      </a>
      <a
        href="https://github.com/jf8peas/explain-machine-learning-in-cricket-terms/issues/new"
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center gap-[11px] rounded-[9px] p-2.5 text-mist-light transition-colors hover:bg-white/5 hover:text-white"
      >
        <span
          class="flex h-[26px] w-[26px] flex-none items-center justify-center rounded-[7px] bg-white/[0.08] font-mono text-[10px] font-semibold tracking-[0.02em] text-gold"
          >GH</span
        >
        <span class="flex min-w-0 flex-col gap-0.5 text-left">
          <span class="text-[13px] font-medium leading-[1.25]"
            >Feedback / Report Issue</span
          >
          <span class="font-mono text-[9.5px] tracking-[0.06em] text-mist">
            github issues · new
          </span>
        </span>
        <span
          class="ml-auto font-mono text-[11px] text-mist transition-colors group-hover:text-gold"
          >↗</span
        >
      </a>
    </div>
  </aside>

  <!-- MAIN -->
  <main
    class="min-w-0 flex-[3_1_520px] overflow-hidden rounded-2xl border border-line bg-white shadow-[0_1px_0_rgba(11,15,13,.04),0_12px_30px_rgba(11,15,13,.06)]"
  >
    <!-- Section hero -->
    <header
      class="relative overflow-hidden bg-[linear-gradient(140deg,#0B2B1A_0%,#0F3A24_55%,#071D11_100%)] px-[clamp(20px,3.4vw,44px)] pb-[clamp(18px,2.6vw,26px)] pt-[clamp(22px,3.4vw,38px)]"
    >
      <div
        class="pointer-events-none absolute inset-0"
        style="background:repeating-linear-gradient(115deg,rgba(255,255,255,.045) 0 1px,transparent 1px 22px)"
      >
      </div>
      <div class="relative flex flex-col gap-3">
        <span
          class="font-mono text-[10px] font-medium uppercase tracking-[0.18em] text-gold"
          >Session {inn.number}</span
        >
        <h1
          class="m-0 text-balance font-display text-[clamp(28px,4vw,46px)] font-extrabold leading-[1.02] tracking-[-0.035em] text-white"
        >
          {inn.title}
        </h1>
        <p class="m-0 font-mono text-[11px] tracking-[0.08em] text-mist">
          {inn.subtitle}
        </p>
      </div>
    </header>

    <!-- Chapter cards -->
    <article
      class="flex flex-col gap-[clamp(20px,2.4vw,30px)] px-[clamp(20px,3.4vw,44px)] py-[clamp(22px,3vw,38px)]"
    >
      <div class="grid gap-[clamp(14px,2vw,22px)] md:grid-cols-3">
        {
          inn.chapters.map((c, j) => (
            <a
              href={url(`${inn.slug}/${c.slug}/`)}
              class="group flex flex-col gap-3 rounded-2xl border border-line bg-white p-[clamp(16px,2vw,22px)] shadow-[0_1px_0_rgba(11,15,13,.04)] transition-all hover:-translate-y-0.5 hover:border-pitch hover:shadow-[0_12px_30px_rgba(11,15,13,.08)]"
            >
              <div class="flex items-center justify-between gap-2">
                <span class="flex h-[30px] w-[38px] items-center justify-center rounded-[8px] bg-pitch font-mono text-[11px] font-medium text-gold">
                  {inn.index + 1}.{j + 1}
                </span>
                <span class="font-mono text-[9.5px] uppercase tracking-[0.12em] text-slate-custom">
                  {c.meta}
                </span>
              </div>
              <h2 class="m-0 font-display text-[19px] font-bold leading-[1.15] tracking-[-0.02em] text-pitch">
                {c.nav}
              </h2>
              <p class="m-0 flex-1 text-[13.5px] leading-[1.55] text-ink-soft">
                {c.lede}
              </p>
              <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-gold-deep transition-colors group-hover:text-pitch">
                Start over & explore →
              </span>
            </a>
          ))
        }
      </div>
    </article>
  </main>
</div>