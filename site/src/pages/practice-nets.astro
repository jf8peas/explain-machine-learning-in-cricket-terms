---
import BaseLayout from "../layouts/BaseLayout.astro";
import MatchSituation from "../components/MatchSituation.astro";
import { innings, totalChapters } from "../data/innings";
import { url } from "../utils/paths";
import quizBank from "../data/quiz-bank.json";

interface QuizItem {
  id: string;
  type: "mcq" | "short_answer";
  chapterId: string;
  chapterTitle: string;
  sourceUrl: string;
  question: string;
  options?: string[];
  correctAnswerIndex?: number;
  explanation?: string;
  modelAnswer?: string;
  rubric?: string[];
}

const bank = quizBank as QuizItem[];

// Build chapter lookup: slug -> { nav, over, innings, url }
const chapterMeta = new Map<string, { nav: string; over: string; innings: string; url: string }>();
for (const inn of innings) {
  inn.chapters.forEach((c, j) => {
    chapterMeta.set(c.slug, {
      nav: c.nav,
      over: `${inn.index + 1}.${j + 1}`,
      innings: inn.title,
      url: url(`${inn.slug}/${c.slug}/`),
    });
  });
}

const chaptersWithQuestions = new Set(bank.map((q) => q.chapterId));

const scopeOptions = [
  { v: "all", label: "All 28 Chapters (Full Match)" },
  ...innings.flatMap((inn) =>
    inn.chapters
      .map((c, j) => ({
        v: c.slug,
        label: `${inn.index + 1}.${j + 1} ${c.title}`,
      }))
      .filter((o) => chaptersWithQuestions.has(o.v)),
  ),
];
---

