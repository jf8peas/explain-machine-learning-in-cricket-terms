            </div>

            <div class="flex flex-wrap gap-3.5 pt-1.5">
              <button id="quiz-again" type="button" class="inline-flex h-[54px] flex-[1_1_240px] items-center justify-center gap-2.5 rounded-[11px] bg-gold text-[17px] font-semibold text-pitch transition-colors hover:bg-gold-light">Another Net Session<span class="font-mono text-[15px]">→</span></button>
              <a href={url()} class="inline-flex h-[54px] flex-[1_1_200px] items-center justify-center rounded-[11px] border border-line text-[16px] font-medium text-pitch transition-colors hover:border-pitch">Back to the chapters</a>
            </div>
          </div>
        </section>
      </article>
    </main>
  </div>
</BaseLayout>

<script define:vars={{ bank, chapterMeta: Object.fromEntries(chapterMeta) }}>
  import { PROGRESS_EVENT, loadProgress } from "../utils/progress";

  // ── Data injected from the Astro frontmatter ──
  const BANK = bank as any[];
  const CHAPTER_META = chapterMeta as Record<string, { nav: string; over: string; innings: string; url: string }>;

  // ── DOM refs ──
  const setup = document.getElementById("quiz-setup");
  const running = document.getElementById("quiz-running");
  const done = document.getElementById("quiz-done");
  const scopeSel = document.getElementById("quiz-scope") as HTMLSelectElement | null;
  const startBtn = document.getElementById("quiz-start");
  const phase = document.getElementById("quiz-phase");
  const scopeLabel = document.getElementById("quiz-scope-label");
  const counter = document.getElementById("quiz-counter");
  const progressBar = document.getElementById("quiz-progress");
  const qOver = document.getElementById("quiz-over");
  const qText = document.getElementById("quiz-question");
  const mcqBox = document.getElementById("quiz-mcq");
  const saBox = document.getElementById("quiz-sa");
  const answerTa = document.getElementById("quiz-answer") as HTMLTextAreaElement | null;
  const charCount = document.getElementById("quiz-char-count");
  const submitSa = document.getElementById("quiz-submit-sa") as HTMLButtonElement | null;
  const saStatus = document.getElementById("quiz-sa-status");
  const nextBtn = document.getElementById("quiz-next") as HTMLButtonElement | null;
  const quitBtn = document.getElementById("quiz-quit");
  const finalScore = document.getElementById("quiz-final-score");
  const percentile = document.getElementById("quiz-percentile");
  const resultStats = document.getElementById("quiz-result-stats");
  const coachOne = document.getElementById("quiz-coach-one");
  const coachTwo = document.getElementById("quiz-coach-two");
  const reviewSection = document.getElementById("quiz-review-section");
  const reviewSummary = document.getElementById("quiz-review-summary");
  const reviewBox = document.getElementById("quiz-review");
  const weakSpots = document.getElementById("quiz-weak-spots");
  const weakLinks = document.getElementById("quiz-weak-links");
  const againBtn = document.getElementById("quiz-again");
  const headerBar = document.getElementById("header-progress-bar");
  const headerCount = document.getElementById("header-progress-count");

  // ── State ──
  let scope = "all";
  let mode: "setup" | "q" | "done" = "setup";
  let i = 0;
  let plan: { t: "mcq" | "sa"; q: any; key: string }[] = [];
  let picks: Record<string, number> = {};
  let texts: Record<string, string> = {};
  let saScores: Record<string, { score: number; feedback: string }> = {};
  let saLoading = false;

  // ── Read ?chapter= from URL to pre-filter scope ──
  const params = new URLSearchParams(window.location.search);
  const chapterParam = params.get("chapter");
  const hasQuestions = (chId: string) => BANK.some((q: any) => q.chapterId === chId);
  if (chapterParam && CHAPTER_META[chapterParam] && hasQuestions(chapterParam)) {
    scope = chapterParam;
    if (scopeSel) scopeSel.value = chapterParam;
  }

  // ── Fisher-Yates shuffle ──
  function shuffle<T>(arr: T[]): T[] {
    const a = [...arr];
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  // ── Build plan from bank ──
  function buildPlan(): { t: "mcq" | "sa"; q: any; key: string }[] {
    const items = scope === "all" ? BANK : BANK.filter((q: any) => q.chapterId === scope);
    const mcqs = items.filter((q: any) => q.type === "mcq");
    const sas = items.filter((q: any) => q.type === "short_answer");

    // For "all" scope, pick 10 MCQs and 5 SAs (shuffled)
    const selectedMcqs = scope === "all" ? shuffle(mcqs).slice(0, 10) : mcqs;
    const selectedSas = scope === "all" ? shuffle(sas).slice(0, 5) : sas;

    return [
      ...selectedMcqs.map((q: any, idx: number) => ({ t: "mcq" as const, q, key: "mcq" + idx })),
      ...selectedSas.map((q: any, idx: number) => ({ t: "sa" as const, q, key: "sa" + idx })),
    ];
  }

  function scopeLabelText(): string {
    if (scope === "all") return "All 28 Chapters (Full Match)";
    const m = CHAPTER_META[scope];
    return m ? `${m.over} ${m.nav}` : scope;
  }

  function escapeHtml(s: string): string {
    const amp = String.fromCharCode(38);
    const lt = String.fromCharCode(60);
    const gt = String.fromCharCode(62);
    const quot = String.fromCharCode(34);
    const apos = String.fromCharCode(39);
    return s
      .replace(new RegExp(amp, "g"), amp + "amp;")
      .replace(new RegExp(lt, "g"), amp + "lt;")
      .replace(new RegExp(gt, "g"), amp + "gt;")
      .replace(new RegExp(quot, "g"), amp + "quot;")
      .replace(new RegExp(apos, "g"), amp + "#039;");
  }

  // ── Grade a short answer via /api/grade ──
  const API_BASE = (import.meta.env.BASE_URL || "/").replace(/\/+$/, "");

  async function gradeSa(key: string, q: any, answer: string): Promise<void> {
    saLoading = true;
    render();

    try {
      const res = await fetch(`${API_BASE}/api/grade`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          question: q.question,
          answer,
          modelAnswer: q.modelAnswer,
          rubric: q.rubric,
        }),
      });

      if (!res.ok) {
        const err = await res.json().catch(() => ({ error: "Unknown error" }));
        saScores[key] = { score: 0, feedback: `Grading failed: ${err.error || "Unknown error"}` };
      } else {
        const data = await res.json();
        saScores[key] = { score: data.score ?? 0, feedback: data.feedback ?? "" };
      }
    } catch (err) {
      saScores[key] = {
        score: 0,
        feedback: `Grading failed: ${err instanceof Error ? err.message : String(err)}`,
      };
    }

    saLoading = false;
    render();
  }

  // ── Compute weak spots (top 2 chapters to revise) ──
  function computeWeakSpots(): { chapterId: string; nav: string; over: string; url: string; note: string }[] {
    const chapterScores = new Map<string, { total: number; earned: number; count: number }>();

    plan.forEach((p) => {
      const chId = p.q.chapterId;
      if (!chapterScores.has(chId)) {
        chapterScores.set(chId, { total: 0, earned: 0, count: 0 });
      }
      const entry = chapterScores.get(chId)!;
      entry.count += 1;

      if (p.t === "mcq") {
        entry.total += 1;
        const picked = picks[p.key];
        if (picked === p.q.correctAnswerIndex) entry.earned += 1;
      } else {
        entry.total += 3;
        const score = saScores[p.key]?.score ?? 0;
        entry.earned += score;
      }
    });

    // Sort by lowest earned ratio, then by count (more questions = more important)
    const sorted = [...chapterScores.entries()]
      .map(([chId, s]) => ({
        chapterId: chId,
        ratio: s.total > 0 ? s.earned / s.total : 1,
        count: s.count,
        earned: s.earned,
        total: s.total,
      }))
      .sort((a, b) => a.ratio - b.ratio || b.count - a.count);

    // Take top 2 weakest (or all if fewer)
    return sorted.slice(0, 2).map((s) => {
      const meta = CHAPTER_META[s.chapterId];
      const dropped = s.total - s.earned;
      return {
        chapterId: s.chapterId,
        nav: meta?.nav ?? s.chapterId,
        over: meta?.over ?? "",
        url: meta?.url ?? "/",
        note: dropped > 0 ? `${dropped} dropped` : "solid",
      };
    });
  }

  // ── Render ──
  function render() {
    if (!setup || !running || !done) return;
    setup.classList.toggle("hidden", mode !== "setup");
    running.classList.toggle("hidden", mode !== "q");
    done.classList.toggle("hidden", mode !== "done");

    if (mode === "q") {
      const cur = plan[i];
      const total = plan.length;
      const isMcq = cur.t === "mcq";
      const key = cur.key;
      const picked = picks[key];
      const text = texts[key] || "";
      const saScore = saScores[key];

      if (phase) phase.textContent = isMcq ? "[ Throw Downs ]" : "[ Net Session ]";
      if (scopeLabel) scopeLabel.textContent = scopeLabelText();
      if (counter) counter.textContent = `Question ${i + 1} of ${total}`;
      if (progressBar) progressBar.style.width = `${Math.round(((i + 1) / total) * 100)}%`;
      if (qOver) qOver.textContent = cur.q.chapterTitle || scopeLabelText();
      if (qText) qText.textContent = cur.q.question;

      // MCQ options
      if (mcqBox) {
        mcqBox.classList.toggle("hidden", !isMcq);
        mcqBox.innerHTML = "";
        if (isMcq && cur.q.options) {
          cur.q.options.forEach((opt: string, oi: number) => {
            const on = picked === oi;
            const btn = document.createElement("button");
            btn.type = "button";
            btn.dataset.o = String(oi);
            btn.className =
              "flex w-full items-center gap-3.5 rounded-[12px] border px-[18px] py-4 text-left transition-colors " +
              (on ? "border-gold bg-[#FBF6E2] text-pitch" : "border-line bg-white text-ink hover:border-pitch");
            btn.innerHTML = `
              <span class="flex h-8 w-8 flex-none items-center justify-center rounded-[8px] font-mono text-[13px] ${on ? "bg-gold text-pitch" : "bg-card text-slate-custom"}">${"ABCD"[oi]}</span>
              <span class="min-w-0 flex-1 text-[16px] leading-[1.45]">${escapeHtml(opt)}</span>
              <span class="w-4 flex-none text-right font-mono text-[14px] text-gold-deep">${on ? "✓" : ""}</span>
            `;
            btn.addEventListener("click", () => {
              picks[key] = oi;
              render();
            });
            mcqBox.appendChild(btn);
          });
        }
      }

      // Short answer
      if (saBox) {
        saBox.classList.toggle("hidden", isMcq);
        saBox.classList.toggle("flex", !isMcq);
      }
      if (answerTa) {
        answerTa.value = text;
        answerTa.classList.toggle("hidden", isMcq);
      }
      if (charCount) charCount.textContent = `${text.length} / 600 characters`;
      if (submitSa) {
        const canSubmit = text.trim().length > 0 && !saLoading && !saScore;
        submitSa.disabled = !canSubmit;
        submitSa.classList.toggle("hidden", isMcq);
        submitSa.textContent = saLoading ? "Grading…" : saScore ? "Graded" : "Submit to AI Coach";
      }

      // SA status box
      if (saStatus) {
        saStatus.classList.toggle("hidden", isMcq || (!saLoading && !saScore));
        saStatus.classList.toggle("flex", !isMcq && (saLoading || saScore));
        if (!isMcq) {
          if (saLoading) {
            saStatus.innerHTML = `
              <div class="flex items-center gap-2.5">
                <span class="h-3.5 w-3.5 flex-none animate-spin rounded-full border-2 border-gold border-t-transparent"></span>
                <span class="font-mono text-[12px] text-slate-custom">AI Coach is reviewing your answer…</span>
              </div>
            `;
          } else if (saScore) {
            const color = saScore.score >= 2 ? "text-[#1F5A38]" : saScore.score === 1 ? "text-gold-deep" : "text-[#8C3021]";
            const bg = saScore.score >= 2 ? "bg-[#E4F2E8]" : saScore.score === 1 ? "bg-[#FBF6E2]" : "bg-[#FAE7E4]";
            saStatus.innerHTML = `
              <div class="flex items-center gap-2.5">
                <span class="inline-flex h-6 items-center rounded-[6px] px-2.5 font-mono text-[10px] font-medium uppercase tracking-[0.14em] ${bg} ${color}">${saScore.score} / 3</span>
                <span class="font-mono text-[12px] text-slate-custom">AI Coach verdict</span>
              </div>
              ${saScore.feedback ? `<p class="m-0 text-[14px] leading-[1.5] text-ink-soft">${escapeHtml(saScore.feedback)}</p>` : ""}
            `;
          }
        }
      }

      // Next button
      if (nextBtn) {
        const canNext = isMcq
          ? picked !== undefined
          : text.trim().length > 0 && (saScore !== undefined || saLoading);
        nextBtn.disabled = !canNext;
        nextBtn.textContent = i === total - 1 ? "See the scorecard" : "Next delivery";
        nextBtn.classList.toggle("hidden", !isMcq);
      }
    }

    if (mode === "done") {
      const mcqItems = plan.filter((p) => p.t === "mcq");
      const saItems = plan.filter((p) => p.t === "sa");
      const mcqAsked = mcqItems.length;
      const saAsked = saItems.length;

      const correct = mcqItems.filter((p) => picks[p.key] === p.q.correctAnswerIndex).length;
      const saTotal = saItems.reduce((sum, p) => sum + (saScores[p.key]?.score ?? 0), 0);
      const saMax = saAsked * 3;

      const mcqPct = mcqAsked ? correct / mcqAsked : 0;
      const saPct = saMax ? saTotal / saMax : 0;
      const wM = mcqAsked ? 0.7 : 0;
      const wS = saAsked ? 0.3 : 0;
      const overall = Math.round(((mcqPct * 100 * wM) + (saPct * 100 * wS)) / (wM + wS || 1));
      const pctile = Math.max(2, Math.min(96, 100 - overall));

      if (finalScore) finalScore.textContent = overall + "%";
      if (percentile) {
        percentile.textContent = overall >= 50
          ? `Top ${pctile}% of net sessions logged this week.`
          : `Bottom ${100 - pctile}% of net sessions logged this week. Worth another go.`;
      }

      // Result stats
      if (resultStats) {
        resultStats.innerHTML = "";
        const stats: { k: string; v: string; s: string }[] = [];
        if (mcqAsked) stats.push({ k: "Throw Downs", v: `${correct} / ${mcqAsked}`, s: "multiple choice" });
        if (saAsked) stats.push({ k: "Net Session", v: `${saTotal} / ${saMax}`, s: "rubric points" });
        stats.push({ k: "Time at the crease", v: `${4 + plan.length} min`, s: `across ${plan.length} ${plan.length === 1 ? "delivery" : "deliveries"}` });
        for (const st of stats) {
          const div = document.createElement("div");
          div.className = "flex flex-col gap-1.5";
          div.innerHTML = `
            <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-slate-custom">${st.k}</span>
            <span class="font-display text-[25px] font-bold leading-none tracking-[-0.03em] text-pitch">${st.v}</span>
            <span class="text-[12.5px] text-gray-500">${st.s}</span>
          `;
          resultStats.appendChild(div);
        }
      }

      // Coach commentary
      if (coachOne) {
        coachOne.textContent = overall >= 80
          ? "Solid session. Your definitions are quick and your written answers name the mechanism rather than the metric, which is the part most people skip."
          : "Reasonable session. You are quick on definitions and slower on the questions that ask why a number is misleading, which is where the marks sit.";
      }
      if (coachTwo) {
        coachTwo.textContent = "Two habits for next time: state the failure mode before the fix, and when a question mentions a score, say what the errors cost before you say whether the score is good.";
      }

      // Ball-by-ball review
      if (reviewSection && reviewSummary && reviewBox) {
        reviewSection.classList.toggle("hidden", plan.length === 0);
        reviewSection.classList.toggle("flex", plan.length > 0);
        if (plan.length > 0) {
          reviewSummary.textContent = `${correct} of ${mcqAsked} multiple choice right · ${saTotal} of ${saMax} rubric points · ${overall}% overall`;
          reviewBox.innerHTML = "";

          plan.forEach((p, n) => {
            const row = document.createElement("div");
            if (p.t === "mcq") {
              const chosen = picks[p.key];
              const ok = chosen === p.q.correctAnswerIndex;
              const verdict = ok ? "Right" : "Wrong";
              const detail = ok
                ? p.q.options[p.q.correctAnswerIndex]
                : `You said: ${p.q.options[chosen] ?? "—"}`;
              const fix = ok ? "" : `Right answer: ${p.q.options[p.q.correctAnswerIndex]}`;
              const badgeBg = ok ? "bg-[#E4F2E8] text-[#1F5A38]" : "bg-[#FAE7E4] text-[#8C3021]";
              const border = ok ? "border-l-[#4C9A6A]" : "border-l-[#C4543F]";
              row.className = `flex flex-wrap gap-3 rounded-[11px] border border-line border-l-[3px] bg-white px-4 py-3.5 ${border}`;
              row.innerHTML = `
                <span class="w-[26px] flex-none font-mono text-[12px] text-[#8A8F8B]">${n + 1}</span>
                <span class="flex min-w-0 flex-[1_1_380px] flex-col gap-1.5">
                  <span class="font-mono text-[10.5px] uppercase tracking-[0.12em] text-slate-custom">${escapeHtml(p.q.chapterTitle || "")} · Throw down</span>
                  <span class="text-[15.5px] font-medium leading-[1.4] text-pitch">${escapeHtml(p.q.question)}</span>
                  <span class="text-[14.5px] leading-[1.5] text-gray-500">${escapeHtml(detail)}</span>
                  ${fix ? `<span class="font-mono text-[12px] text-gold-deep">${escapeHtml(fix)}</span>` : ""}
                </span>
                <span class="inline-flex h-6 flex-none items-center rounded-[6px] px-2.5 font-mono text-[10px] uppercase tracking-[0.14em] ${badgeBg}">${verdict}</span>
              `;
            } else {
              const score = saScores[p.key]?.score ?? 0;
              const feedback = saScores[p.key]?.feedback ?? "";
              const badgeBg = score >= 2 ? "bg-[#E4F2E8] text-[#1F5A38]" : score === 1 ? "bg-[#FBF6E2] text-gold-deep" : "bg-[#FAE7E4] text-[#8C3021]";
              const border = score >= 2 ? "border-l-[#4C9A6A]" : score === 1 ? "border-l-gold" : "border-l-[#C4543F]";
              row.className = `flex flex-wrap gap-3 rounded-[11px] border border-line border-l-[3px] bg-white px-4 py-3.5 ${border}`;
              row.innerHTML = `
                <span class="w-[26px] flex-none font-mono text-[12px] text-[#8A8F8B]">${n + 1}</span>
                <span class="flex min-w-0 flex-[1_1_380px] flex-col gap-1.5">
                  <span class="font-mono text-[10.5px] uppercase tracking-[0.12em] text-slate-custom">${escapeHtml(p.q.chapterTitle || "")} · Net session</span>
                  <span class="text-[15.5px] font-medium leading-[1.4] text-pitch">${escapeHtml(p.q.question)}</span>
                  <span class="text-[14.5px] leading-[1.5] text-gray-500">You wrote: ${escapeHtml(texts[p.key] || "—")}</span>
                  ${feedback ? `<span class="font-mono text-[12px] text-gold-deep">Coach: ${escapeHtml(feedback)}</span>` : ""}
                </span>
                <span class="inline-flex h-6 flex-none items-center rounded-[6px] px-2.5 font-mono text-[10px] uppercase tracking-[0.14em] ${badgeBg}">${score} / 3</span>
              `;
            }
            reviewBox.appendChild(row);
          });
        }
      }

      // Weak spots (top 2 revision chapters)
      if (weakSpots && weakLinks) {
        const spots = computeWeakSpots();
        weakSpots.classList.toggle("hidden", spots.length === 0);
        weakSpots.classList.toggle("flex", spots.length > 0);
        if (spots.length > 0) {
          weakLinks.innerHTML = "";
          spots.forEach((w) => {
            const a = document.createElement("a");
            a.href = w.url;
            a.className = "group flex items-center gap-[13px] rounded-[11px] border border-line bg-white px-[15px] py-[13px] text-pitch transition-colors hover:border-gold hover:bg-[#FBF6E2]";
            a.innerHTML = `
              <span class="flex h-[30px] w-11 flex-none items-center justify-center rounded-[7px] bg-card font-mono text-[12px] text-slate-custom">${escapeHtml(w.over)}</span>
              <span class="min-w-0 flex-1 text-[15.5px] font-medium text-pitch">${escapeHtml(w.nav)}</span>
              <span class="flex-none font-mono text-[12px] text-slate-custom">${escapeHtml(w.note)}</span>
              <span class="flex-none font-mono text-[14px] text-gold-deep transition-transform group-hover:translate-x-0.5">→</span>
            `;
            weakLinks.appendChild(a);
          });
        }
      }
    }
  }

  // ── Events ──
  scopeSel?.addEventListener("change", (e) => {
    scope = (e.target as HTMLSelectElement).value;
  });

  startBtn?.addEventListener("click", () => {
    mode = "q";
    i = 0;
    picks = {};
    texts = {};
    saScores = {};
    saLoading = false;
    plan = buildPlan();
    render();
  });

  nextBtn?.addEventListener("click", () => {
    const cur = plan[i];
    if (cur.t === "mcq" && picks[cur.key] === undefined) return;
    if (cur.t === "sa" && !(texts[cur.key] || "").trim()) return;
    if (i === plan.length - 1) {
      mode = "done";
      render();
    } else {
      i += 1;
      render();
    }
  });

  submitSa?.addEventListener("click", () => {
    const cur = plan[i];
    if (!cur || cur.t !== "sa") return;
    const text = texts[cur.key] || "";
    if (!text.trim() || saScores[cur.key] || saLoading) return;
    gradeSa(cur.key, cur.q, text);
  });

  answerTa?.addEventListener("input", (e) => {
    const cur = plan[i];
    if (!cur) return;
    texts[cur.key] = (e.target as HTMLTextAreaElement).value;
    render();
  });

  quitBtn?.addEventListener("click", () => {
    mode = "setup";
    i = 0;
    render();
  });

  againBtn?.addEventListener("click", () => {
    mode = "setup";
    i = 0;
    picks = {};
    texts = {};
    saScores = {};
    saLoading = false;
    plan = [];
    render();
  });

  // ── Header progress ──
  function refreshHeader(): void {
    const data = loadProgress();
    const doneCount = data.completedChapters.length;
    const total = Number(headerCount?.dataset.total ?? 28);
    const pct = total > 0 ? Math.min(100, Math.round((doneCount / total) * 100)) : 0;
    if (headerBar) headerBar.style.width = `${pct}%`;
    if (headerCount) headerCount.textContent = `${doneCount}/${total}`;
  }
  refreshHeader();
  window.addEventListener(PROGRESS_EVENT, refreshHeader);

  // Initial render
  render();
</script>