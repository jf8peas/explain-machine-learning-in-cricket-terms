              </span>
              <div class="flex min-w-0 flex-col gap-2.5">
                <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-gold-deep">Dressing Room Commentary</span>
                <p id="quiz-coach-one" class="m-0 text-[16.5px] leading-[1.6] text-ink"></p>
                <p id="quiz-coach-two" class="m-0 text-[16.5px] leading-[1.6] text-gray-500"></p>
              </div>
            </div>

            <!-- Ball-by-ball review -->
            <div id="quiz-review-section" class="hidden flex-col gap-3">
              <div class="flex flex-wrap items-baseline gap-3">
                <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-slate-custom">Ball-by-ball review</span>
                <span id="quiz-review-summary" class="font-mono text-[11.5px] text-gold-deep"></span>
              </div>
