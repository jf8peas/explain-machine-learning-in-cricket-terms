            </div>

            <!-- Back to the nets on -->
            <div id="quiz-weak-spots" class="hidden flex-col gap-2.5">
              <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-slate-custom">Back to the nets on</span>
